<ul class="themes">
  {%- for theme in site.data.themes %}
    {%- assign theme_page = null -%}
    {%- if theme.page -%}{%- assign theme_page = site.pages | where: 'url', theme.page | first -%}{%- endif -%}
    {%- assign theme_papers = site.data.research.papers | where_exp: 'p', 'p.topics contains theme.id' -%}
    {%- assign n_papers = theme_papers | size -%}
    {%- assign draft_page = false -%}
    {%- if theme_page and theme_page.published == false -%}{%- assign draft_page = true -%}{%- endif -%}
    <li class="theme-card{% if theme_page %} is-linked{% endif %}">
      {% include icon.liquid name=theme.icon %}
      <h3>
        {%- if theme_page -%}
          <a href="{{ theme.page | relative_url }}">{{ theme.title | escape }}</a>
        {%- else -%}
          {{ theme.title | escape }}
        {%- endif -%}
      </h3>
      <p>{{ theme.question | escape }}</p>
      <div class="theme-foot">
        <span>
          {{- n_papers }}
          {% if n_papers == 1 %}paper{% else %}papers{% endif -%}
        </span>
        {%- if theme_page %}
          <span class="more"
            >Read more →
            {%- if draft_page -%}
              <span class="draft-tag">Draft</span>
            {%- endif -%}
          </span>
        {%- endif %}
      </div>
    </li>
  {%- endfor %}
</ul>
