{%- include site-data.liquid -%}
<div class="split">
  {%- if talk_count > 0 %}
    <div>
      <h3>Talks &amp; posters</h3>
      <ul class="entry-list">
        {%- for t in talk_items %}
          <li class="entry{% if t.draft %} is-draft{% endif %}">
            <div class="entry-top">
              <span>
                {{- t.kind | default: 'Talk' -}}
                {%- if t.draft -%}
                  <span class="draft-tag">Draft</span>
                {%- endif -%}
              </span>
              <time datetime="{{ t.date | date: '%Y-%m' }}">{{ t.date | date: '%b %Y' }}</time>
            </div>
            <p class="entry-title">{{ t.title | escape }}</p>
            <p class="entry-sub">
              {%- if t.event_url -%}
                <a href="{{ t.event_url }}">{{ t.event | escape }}</a>
              {%- else -%}
                {{- t.event | escape -}}
              {%- endif -%}
              {%- if t.location %} · {{ t.location | escape }}{% endif -%}
              {%- if t.slides or t.poster or t.video %}
                <span class="entry-links">
                  {%- if t.slides -%}
                    <a href="{{ t.slides | relative_url }}">Slides</a>
                  {%- endif -%}
                  {%- if t.poster -%}
                    <a href="{{ t.poster | relative_url }}">Poster</a>
                  {%- endif -%}
                  {%- if t.video -%}
                    <a href="{{ t.video | relative_url }}">Video</a>
                  {%- endif -%}
                </span>
              {%- endif -%}
            </p>
          </li>
        {%- endfor %}
      </ul>
    </div>
  {%- endif %}
  {%- if teaching_count > 0 %}
    <div>
      <h3>Teaching &amp; supervision</h3>
      <ul class="entry-list">
        {%- for c in teaching_items %}
          <li class="entry{% if c.draft %} is-draft{% endif %}">
            <div class="entry-top">
              <span>
                {{- c.role | escape -}}
                {%- if c.draft -%}
                  <span class="draft-tag">Draft</span>
                {%- endif -%}
              </span>
              {%- if c.terms -%}
                <span>{{ c.terms | escape }}</span>
              {%- endif -%}
            </div>
            <p class="entry-title">
              {%- if c.url -%}
                <a href="{{ c.url }}">{{ c.title | escape }}</a>
              {%- else -%}
                {{- c.title | escape -}}
              {%- endif -%}
              {%- if c.code %}
                <span class="entry-sub">({{ c.code | escape }})</span>
              {%- endif -%}
            </p>
            {%- if c.note %}
              <p class="entry-sub">{{ c.note | escape }}</p>
            {% endif -%}
          </li>
        {%- endfor %}
      </ul>
    </div>
  {%- endif %}
</div>
