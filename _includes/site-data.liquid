{%- comment -%}
  Computes the lists shown on the site. On the live site (JEKYLL_ENV=production)
  entries marked `draft: true` are left out; in local previews they are shown
  with a "Draft" tag so you can see what still needs filling in.
{%- endcomment -%}
{%- assign is_preview = true -%}
{%- if jekyll.environment == 'production' -%}{%- assign is_preview = false -%}{%- endif -%}
{%- if is_preview -%}
  {%- assign news_items = site.data.news -%}
  {%- assign talk_items = site.data.talks -%}
  {%- assign teaching_items = site.data.teaching -%}
{%- else -%}
  {%- assign news_items = site.data.news | where_exp: 'i', 'i.draft != true' -%}
  {%- assign talk_items = site.data.talks | where_exp: 'i', 'i.draft != true' -%}
  {%- assign teaching_items = site.data.teaching | where_exp: 'i', 'i.draft != true' -%}
{%- endif -%}
{%- assign news_count = news_items | size -%}
{%- assign talk_count = talk_items | size -%}
{%- if site.data.profile.show_talks == false -%}{%- assign talk_count = 0 -%}{%- endif -%}
{%- assign teaching_count = teaching_items | size -%}
