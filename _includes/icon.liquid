{%- comment -%}Small line illustrations used on theme cards. Usage: {% include icon.liquid name="dendrogram" %}{%- endcomment -%}
{%- case include.name -%}
  {%- when 'dendrogram' -%}
    <svg
      class="{{ include.class | default: 'theme-icon' }}"
      viewBox="0 0 48 40"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M5 33V26H12V33M8.5 26V17H19V33M13.75 17V8H36V22M29 33V22H43V33M36 33V22M24.9 8V3"/><g fill="currentColor" stroke="none"><circle cx="5" cy="35" r="{{ include.dot | default: 1.9 }}"/><circle cx="12" cy="35" r="{{ include.dot | default: 1.9 }}"/><circle cx="19" cy="35" r="{{ include.dot | default: 1.9 }}"/><circle cx="29" cy="35" r="{{ include.dot | default: 1.9 }}"/><circle cx="36" cy="35" r="{{ include.dot | default: 1.9 }}"/><circle cx="43" cy="35" r="{{ include.dot | default: 1.9 }}"/></g>
    </svg>
  {%- when 'communities' -%}
    <svg
      class="{{ include.class | default: 'theme-icon' }}"
      viewBox="0 0 44 44"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
      focusable="false"
    >
      <ellipse cx="22" cy="22" rx="19.5" ry="18" stroke-dasharray="2.5 3"/><circle cx="14" cy="19" r="8"/><circle cx="29.5" cy="26" r="8"/><path d="M11 16.5l5.5-1.5M11 16.5l2 6M16.5 15l-3.5 7.5M27 23l6 0.5M27 23l3 6M33 23.5l-3 5.5M16.5 15L27 23" stroke-width="1.1"/><g fill="currentColor" stroke="none"><circle cx="11" cy="16.5" r="1.9"/><circle cx="16.5" cy="15" r="1.9"/><circle cx="13" cy="22.5" r="1.9"/><circle cx="27" cy="23" r="1.9"/><circle cx="33" cy="23.5" r="1.9"/><circle cx="30" cy="29" r="1.9"/></g>
    </svg>
  {%- when 'network' -%}
    <svg
      class="{{ include.class | default: 'theme-icon' }}"
      viewBox="0 0 44 44"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M8 30L17 12M17 12L32 9M8 30l15 6M23 36l13-12M32 9l4 15M17 12l6 24"/><path d="M8 30L32 9" stroke-dasharray="2.5 3"/><g fill="var(--bg-raised)" stroke-width="1.6"><circle cx="8" cy="30" r="3.4"/><circle cx="17" cy="12" r="3.4"/><circle cx="32" cy="9" r="3.4"/><circle cx="36" cy="24" r="3.4"/><circle cx="23" cy="36" r="3.4"/></g><g fill="currentColor" stroke="none"><circle cx="8" cy="30" r="1.6"/><circle cx="32" cy="9" r="1.6"/><circle cx="23" cy="36" r="1.6"/></g>
    </svg>
  {%- when 'moon' -%}
    <svg
      class="icon-moon"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M20.5 13.5A8.5 8.5 0 0 1 10.5 3.5a8.5 8.5 0 1 0 10 10Z"/>
    </svg>
  {%- when 'sun' -%}
    <svg
      class="icon-sun"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>
    </svg>
{%- endcase -%}
