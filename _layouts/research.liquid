<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>
      {% if page.title != 'Home' %}{{ page.title | escape }} · {% endif %}
      Daichi Kuroda
    </title>
    <meta name="description" content="{{ site.description | strip | escape }}">
    <meta name="author" content="Daichi Kuroda">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/img/dk.svg' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/research.css' | relative_url }}">
    <script src="{{ '/assets/js/research.js' | relative_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="monogram" href="{{ '/' | relative_url }}" aria-label="Daichi Kuroda — home">dk<span aria-hidden="true">.</span></a>
        <nav aria-label="Main navigation">
          <a href="{{ '/' | relative_url }}#research">Research</a>
          <a
            href="{% if page.title == 'Home' %}#publications{% else %}{{ '/publications/' | relative_url }}{% endif %}"
            {% if page.title == 'Publications' %}
              aria-current="page"
            {% endif %}
            >Publications</a
          >
          <a href="#contact">Contact</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Dark appearance" aria-pressed="false" hidden>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="19"
            height="19"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/>
          </svg>
        </button>
      </header>
      <main id="main" tabindex="-1">{{ content }}</main>
      <footer class="site-footer" id="contact" aria-label="Contact">
        <a class="contact-address" href="mailto:daichi.kuroda@epfl.ch">daichi.kuroda@epfl.ch</a>
        <p>EPFL · Lausanne, Switzerland</p>
      </footer>
    </div>
  </body>
</html>
